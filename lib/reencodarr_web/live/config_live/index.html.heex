<div class="workbench page-stack">
  <.page_header title="Sources" subtitle="Service endpoints and sync settings.">
    <:actions>
      <.link patch={~p"/configs/new"} class="workbench-button">Add source</.link>
    </:actions>
  </.page_header>
  <.panel>
    <.table
      id="configs"
      rows={@streams.configs}
      row_click={fn {_id, config} -> JS.navigate(~p"/configs/#{config}") end}
    >
      <:col :let={{_id, config}} label="URL">{config.url}</:col>
      <:col :let={{_id, config}} label="API key">
        {"****" <> String.slice(config.api_key || "", -4..-1//1)}
      </:col>
      <:col :let={{_id, config}} label="Enabled">
        {if(config.enabled, do: "Enabled", else: "Disabled")}
      </:col>
      <:col :let={{_id, config}} label="Service">{config.service_type}</:col>
      <:action :let={{_id, config}}>
        <div class="sr-only">
          <.link navigate={~p"/configs/#{config}"}>Show</.link>
        </div>
        <.link patch={~p"/configs/#{config}/edit"} class="section-action">
          Edit
        </.link>
      </:action>
      <:action :let={{id, config}}>
        <.link
          phx-click={JS.push("delete", value: %{id: config.id}) |> hide("##{id}")}
          data-confirm="Delete this config?"
          class="text-red-400 hover:text-red-300"
        >
          Delete
        </.link>
      </:action>
    </.table>
  </.panel>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="config-modal"
  show
  title={@page_title}
  on_cancel={JS.patch(~p"/configs")}
>
  <.live_component
    module={ReencodarrWeb.ConfigLive.FormComponent}
    id={@config.id || :new}
    title={@page_title}
    action={@live_action}
    config={@config}
    patch={~p"/configs"}
  />
</.modal>
