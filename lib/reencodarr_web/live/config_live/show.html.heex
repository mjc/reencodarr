<div class="workbench page-stack">
  <.page_header title={"Source #{@config.id}"}>
    <:actions>
      <.link patch={~p"/configs/#{@config}/show/edit"} class="workbench-button">Edit source</.link>
    </:actions>
  </.page_header>
  <.panel>
    <.list>
      <:item title="URL">{@config.url}</:item>
      <:item title="API key">{"****" <> String.slice(@config.api_key || "", -4..-1//1)}</:item>
      <:item title="Enabled">{@config.enabled}</:item>
      <:item title="Service">{@config.service_type}</:item>
    </.list>
  </.panel>
  <.back navigate={~p"/configs"}>Back to sources</.back>
</div>
<.modal
  :if={@live_action == :edit}
  id="config-modal"
  show
  title={@page_title}
  on_cancel={JS.patch(~p"/configs/#{@config}")}
>
  <.live_component
    module={ReencodarrWeb.ConfigLive.FormComponent}
    id={@config.id}
    title={@page_title}
    action={@live_action}
    config={@config}
    patch={~p"/configs/#{@config}"}
  />
</.modal>
