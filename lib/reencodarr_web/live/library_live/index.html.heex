<div class="workbench page-stack">
  <.page_header
    title="Library paths"
    subtitle="Configure the root paths used to match synced media."
  >
    <:actions>
      <.link patch={~p"/libraries/new"} class="workbench-button">New Library</.link>
    </:actions>
  </.page_header>
  <div id="libraries" class="settings-records">
    <p :if={@libraries == []} id="libraries-empty" class="empty-state">
      No library paths configured.
    </p>
    <article
      :for={library <- @libraries}
      id={"libraries-#{library.id}"}
      class="library-path content-panel"
    >
      <div>
        <h2>{library.path}</h2><p>
          {if(@video_counts.ok?,
            do: "#{Map.get(@video_counts.result, library.id, 0)} videos",
            else: "Loading count…"
          )}
        </p>
      </div>
      <.link navigate={~p"/videos?#{%{search: library.path}}"} class="workbench-button">View videos</.link>
      <.link patch={~p"/libraries/#{library}/edit"} class="section-action">Edit</.link>
      <.link
        phx-click="delete"
        phx-value-id={library.id}
        data-confirm="Delete this library path?"
        class="text-rose-300"
      >Delete</.link>
    </article>
  </div>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="library-modal"
  show
  title={@page_title}
  on_cancel={JS.patch(~p"/libraries")}
>
  <.live_component
    module={ReencodarrWeb.LibraryLive.FormComponent}
    id={@library.id || :new}
    title={@page_title}
    action={@live_action}
    library={@library}
    patch={~p"/libraries"}
  />
</.modal>
