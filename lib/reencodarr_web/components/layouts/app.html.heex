<div class="app-shell">
  <a href="#app-main" class="skip-link">Skip to content</a>
  <aside class="app-sidebar">
    <.link navigate={~p"/"} class="app-brand">Reencodarr</.link>
    <nav id="app-navigation" aria-label="Main navigation">
      <.link
        navigate={~p"/"}
        class={["app-nav-link", @socket.view == ReencodarrWeb.DashboardLive && "is-current"]}
        aria-current={if(@socket.view == ReencodarrWeb.DashboardLive, do: "page")}
      ><.icon name="hero-home" />Dashboard</.link>
      <.link
        navigate={~p"/videos"}
        class={["app-nav-link", @socket.view == ReencodarrWeb.VideosLive && "is-current"]}
        aria-current={if(@socket.view == ReencodarrWeb.VideosLive, do: "page")}
      ><.icon name="hero-film" />Videos</.link>
      <.link
        navigate={~p"/workers"}
        class={["app-nav-link", @socket.view == ReencodarrWeb.WorkersLive && "is-current"]}
        aria-current={if(@socket.view == ReencodarrWeb.WorkersLive, do: "page")}
      ><.icon name="hero-server-stack" />Workers</.link>
      <.link
        navigate={~p"/failures"}
        class={[
          "app-nav-link",
          @socket.view in [ReencodarrWeb.FailuresLive, ReencodarrWeb.BadFilesLive] && "is-current"
        ]}
        aria-current={
          if(@socket.view in [ReencodarrWeb.FailuresLive, ReencodarrWeb.BadFilesLive], do: "page")
        }
      ><.icon name="hero-exclamation-triangle" />Issues</.link>
    </nav>
    <.dropdown id="app-settings" class="app-settings" trigger_class="app-nav-link">
      <:trigger>
        <.icon name="hero-cog-6-tooth" />Settings<.icon
          name="hero-chevron-up"
          class="settings-chevron"
        />
      </:trigger>
      <nav class="workbench-menu" aria-label="Settings">
        <.link navigate={~p"/configs"}><.icon name="hero-link" />Sources</.link>
        <.link navigate={~p"/libraries"}><.icon name="hero-folder" />Library paths</.link>
        <.link navigate={~p"/workers"}><.icon name="hero-server-stack" />Worker setup</.link>
        <.link navigate={~p"/rules"} class="settings-reference"><.icon name="hero-document-text" />Encoding rules</.link>
      </nav>
    </.dropdown>
  </aside>
  <main id="app-main" class="app-main" tabindex="-1">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
